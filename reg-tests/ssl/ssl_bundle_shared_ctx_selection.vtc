#REGTEST_TYPE=bug
varnishtest "OpenSSL selects RSA or ECDSA from a shared bundle context"
feature cmd "$HAPROXY_PROGRAM -cc 'feature(OPENSSL) && ssllib_name_startswith(OpenSSL) && openssl_version_atleast(1.1.1)'"
feature ignore_unknown_macro

server s1 -repeat 8 {
    rxreq
    txresp
} -start

haproxy h1 -conf {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif

    .if !ssllib_name_startswith(AWS-LC)
        tune.ssl.default-dh-param 2048
    .endif

    defaults
        mode http
        option httplog
        retries 0
        log stderr local0 debug err
        option logasap
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    # Cleartext entry point: route to backends with specific TLS settings
    frontend clear-lst
        bind "fd@${clearlst}"

        use_backend be_t12_rsa     if { path /t12_rsa }
        use_backend be_t12_ecdsa   if { path /t12_ecdsa }
        use_backend be_t13_rsa     if { path /t13_rsa }
        use_backend be_t13_ecdsa   if { path /t13_ecdsa }
        use_backend be_t12max_rsa  if { path /t12max_rsa }
        use_backend be_t12_x25519_p384  if { path /t12_x25519_p384 }
        use_backend be_t12_x25519_p256  if { path /t12_x25519_p256 }

    # TLS 1.2 with RSA-only cipher
    backend be_t12_rsa
        server s1 "${h1_ssl_sock}" ssl verify none sni str(example.com) ssl-min-ver TLSv1.2 ssl-max-ver TLSv1.2 ciphers ECDHE-RSA-AES256-GCM-SHA384

    # TLS 1.2 with ECDSA-only cipher
    backend be_t12_ecdsa
        server s1 "${h1_ssl_sock}" ssl verify none sni str(example.com) ssl-min-ver TLSv1.2 ssl-max-ver TLSv1.2 ciphers ECDHE-ECDSA-AES256-GCM-SHA384

    # TLS 1.3 with RSA sigalg only
    backend be_t13_rsa
        server s1 "${h1_ssl_sock}" ssl verify none sni str(example.com) ssl-min-ver TLSv1.3 ssl-max-ver TLSv1.3 sigalgs rsa_pss_rsae_sha256

    # TLS 1.3 with ECDSA sigalg only
    backend be_t13_ecdsa
        server s1 "${h1_ssl_sock}" ssl verify none sni str(example.com) ssl-min-ver TLSv1.3 ssl-max-ver TLSv1.3 sigalgs ecdsa_secp384r1_sha384

    # TLS 1.2 max still allows the RSA certificate (using limited bind)
    backend be_t12max_rsa
        server s1 "${h1_ssl_limited_sock}" ssl verify none sni str(example.com) ciphers ECDHE-RSA-AES256-GCM-SHA384

    # TLS 1.2 with X25519:P-384 groups and ECDSA+RSA ciphers (ECDSA preferred)
    backend be_t12_x25519_p384
        server s1 "${h1_ssl_sock}" ssl verify none sni str(example.com) ssl-min-ver TLSv1.2 ssl-max-ver TLSv1.2 curves X25519:P-384 ciphers ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384

    # TLS 1.2 with X25519:P-256 groups and ECDSA+RSA ciphers (RSA expected)
    backend be_t12_x25519_p256
        server s1 "${h1_ssl_sock}" ssl verify none sni str(example.com) ssl-min-ver TLSv1.2 ssl-max-ver TLSv1.2 curves X25519:P-256 ciphers ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384

    # SSL frontend serving the RSA/ECDSA bundle
    listen ssl-lst
        mode http
        bind "fd@${ssl}" ssl crt ${testdir}/certs/cert1-example.com.pem
        http-response add-header x-ssl-cipher '%[ssl_fc_cipher]'
        http-response add-header x-ssl-keyalg '%[ssl_f_key_alg]'
        server s1 ${s1_addr}:${s1_port}

    # SSL frontend with TLS 1.2 cap
    listen ssl-limited-lst
        mode http
        bind "fd@${ssl_limited}" ssl crt ${testdir}/certs/cert1-example.com.pem ssl-max-ver TLSv1.2
        http-response add-header x-ssl-cipher '%[ssl_fc_cipher]'
        http-response add-header x-ssl-keyalg '%[ssl_f_key_alg]'
        server s1 ${s1_addr}:${s1_port}
} -start

# TLS 1.2 can use either certificate type from the bundle.
client c1 -connect ${h1_clearlst_sock} {
    txreq -url "/t12_rsa"
    rxresp
    expect resp.status == 200
    expect resp.http.x-ssl-cipher == "ECDHE-RSA-AES256-GCM-SHA384"
    expect resp.http.x-ssl-keyalg == "rsaEncryption"
} -run

client c2 -connect ${h1_clearlst_sock} {
    txreq -url "/t12_ecdsa"
    rxresp
    expect resp.status == 200
    expect resp.http.x-ssl-cipher == "ECDHE-ECDSA-AES256-GCM-SHA384"
    expect resp.http.x-ssl-keyalg == "id-ecPublicKey"
} -run

# TLS 1.3 selects a certificate compatible with the offered signature scheme.
client c3 -connect ${h1_clearlst_sock} {
    txreq -url "/t13_ecdsa"
    rxresp
    expect resp.status == 200
    expect resp.http.x-ssl-keyalg == "id-ecPublicKey"
} -run

client c4 -connect ${h1_clearlst_sock} {
    txreq -url "/t13_rsa"
    rxresp
    expect resp.status == 200
    expect resp.http.x-ssl-keyalg == "rsaEncryption"
} -run

# A TLS 1.2 cap still allows the RSA certificate.
client c5 -connect ${h1_clearlst_sock} {
    txreq -url "/t12max_rsa"
    rxresp
    expect resp.status == 200
    expect resp.http.x-ssl-cipher == "ECDHE-RSA-AES256-GCM-SHA384"
} -run

# TLS 1.2 still considers the certificate curve independently of the ECDHE
# group: X25519 can be the key exchange group when P-384 is also advertised.
client c6 -connect ${h1_clearlst_sock} {
    txreq -url "/t12_x25519_p384"
    rxresp
    expect resp.status == 200
    expect resp.http.x-ssl-cipher == "ECDHE-ECDSA-AES256-GCM-SHA384"
} -run

client c7 -connect ${h1_clearlst_sock} {
    txreq -url "/t12_x25519_p256"
    rxresp
    expect resp.status == 200
    expect resp.http.x-ssl-cipher == "ECDHE-RSA-AES256-GCM-SHA384"
} -run
